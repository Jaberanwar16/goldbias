# ============================================
# GOLD & DOLLAR BIAS - CONFIGURATION
# ============================================

# --- API IA (au moins une des deux) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# --- Telegram ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklmNOPqrstUVwxyz
TELEGRAM_CHANNEL_ID=@GoldDollarBias

# --- Base de donnees ---
DATABASE_PATH=data/gold_dollar_bias.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Scraping ---
SCRAPING_INTERVAL_MINUTES=35
MAX_ARTICLES_PER_SCRAPE=20

# --- IA ---
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-20241022
MAX_TOKENS=600
TEMPERATURE=0.3
